# ==============================================================================
# Marketing Management Portal - Backend Environment Configuration
# Copy to .env (or .env.local, which overrides .env) and fill in secrets.
# ==============================================================================

# "development" enables dev sign-in (no Microsoft SSO). Use "production" on every shared server.
APP_ENV=development
SERVICE_NAME=marketing-portal-backend
LOG_LEVEL=INFO
PORT=8010
MCP_PORT=7007

# --- Database (local Docker: docker compose up -d db) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:3009/marketing_portal_dev
DATABASE_SSL=false
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Production database (Supabase) ---
# Never used by the app or tests. scripts/pull_prod_to_local only reads it (one way, prod -> local), and
# scripts/setup_prod_db.py runs migrations on it after a backup.
PROD_DATABASE_URL=
PROD_DATABASE_SSL=true

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180

# --- Sessions & tokens ---
# Both are required (the app won't start without them) and must be DIFFERENT random values of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-32-plus-character-random-string
JWT_SECRET=change-me-to-a-different-32-plus-character-random-string
# Only tokens with this issuer are accepted
JWT_ISSUER=marketing-portal
# Optional: extra issuers to accept, comma-separated (e.g. another portal sharing this JWT_SECRET)
JWT_ACCEPTED_ISSUERS=
AUTH_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

# --- Microsoft Entra ID SSO ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8010/api/auth/microsoft/callback
ALLOWED_EMAIL_DOMAINS=
INITIAL_SUPER_ADMIN_EMAILS=admin@example.com

# --- Optional: Gemini AI assistant (disabled when empty) ---
GEMINI_API_KEY=

# --- Optional: Microsoft Graph background sync ---
GRAPH_BACKGROUND_SYNC_ENABLED=false

# --- Service messaging (same setup as the admin portal) ---
# Announce this service online/offline over MQTT on services/<SERVICE_NAME>/<SERVICE_INSTANCE_ID>/status.
# On by default when APP_ENV=production, off otherwise.
MQTT_PRESENCE_ENABLED=false
SERVICE_NAME=marketing
SERVICE_INSTANCE_ID=marketing-01
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_KEEPALIVE_SECONDS=15
# Connect to RabbitMQ and declare the shared exchanges (nothing is published yet).
# On by default when APP_ENV=production, off otherwise. Use RABBITMQ_URL, or the host/port/user/password below.
RABBITMQ_ENABLED=false
RABBITMQ_URL=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Navan (each event's travel total, from its bookings) ---
# An API credential with "Booking: Read Only". Leave empty to turn Navan off.
NAVAN_CLIENT_ID=
NAVAN_CLIENT_SECRET=
# Defaults: https://app.navan.com/ta-auth/oauth/token (EU: app-fra.navan.com) and https://api.navan.com
NAVAN_TOKEN_URL=
NAVAN_API_BASE=
# How far back to read bookings, by the day they were booked
NAVAN_LOOKBACK_DAYS=365
# Update event travel totals from Navan on a schedule
NAVAN_COST_SYNC_ENABLED=false
# Add an event here for each Navan event with bookings that isn't here yet (off by default: events are
# created in this portal and linked to their Navan event by name or by "Navan event")
NAVAN_CREATE_EVENTS=false
# Navan event names to leave alone, separated by commas: names on bookings that aren't group events (e.g. deleted)
NAVAN_IGNORE_EVENTS=
# Minutes between scheduled syncs (minimum 5)
NAVAN_COST_SYNC_INTERVAL_MINUTES=360
# "live" (default) reads Navan. "demo" makes the sync use generated bookings and estimates for the demo events
# (names starting with "[Demo] ", added by: python scripts/demo_events.py add) instead of calling Navan; real events
# and their Navan costs are left alone. Local development and demos only.
NAVAN_MODE=live

# --- Google Ads (campaigns and weekly results, through the OAuth Integrations page) ---
# "mock": no call to Google. Connecting stores fake tokens and two mock accounts, and the sync generates campaigns and
# weekly results for them (local development and demos). "live": real Google sign-in and the Google Ads API.
# Default when empty: live when APP_ENV=production, mock otherwise. Mock connections are never used in live mode.
GOOGLE_ADS_MODE=
# The OAuth client of the Google Cloud project that has Google Ads API access (live mode). Without them, connecting
# in live mode fails with "Google Ads isn't set up". Add <frontend>/oauth/callback as an authorized redirect URI.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional: sent when set (Google now grants API access levels to the Cloud project)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: the manager (MCC) account id to reach client accounts through, e.g. 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Update Google Ads campaigns and results on a schedule
GOOGLE_ADS_SYNC_ENABLED=false
# Minutes between scheduled syncs (minimum 5)
GOOGLE_ADS_SYNC_INTERVAL_MINUTES=360
# How many days of weekly results to read on every run (conversions change after the fact)
GOOGLE_ADS_LOOKBACK_DAYS=90
# Add a Paid Search campaign here for each Google Ads campaign that isn't linked to one yet
GOOGLE_ADS_CREATE_CAMPAIGNS=true

# --- Microsoft Ads (OAuth Integrations page) ---
# The Microsoft Advertising app's own credentials. Never the portal's sign-in app (MICROSOFT_CLIENT_ID above).
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
