# ==============================================================================
# Marketing Management Portal - Backend Environment Configuration
# Copy to .env (or .env.local, which overrides .env) and fill in secrets.
# ==============================================================================

# "development" enables dev sign-in (no Microsoft SSO). Use "production" on every shared server.
APP_ENV=development
SERVICE_NAME=marketing-portal-backend
LOG_LEVEL=INFO
PORT=8006

# --- Database (local Docker: docker compose up -d db) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:3006/marketing_portal_dev
DATABASE_SSL=false
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5177
CORS_ALLOWED_ORIGINS=http://localhost:5177

# --- Sessions & tokens ---
# Both are required (the app won't start without them) and must be DIFFERENT random values of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-32-plus-character-random-string
JWT_SECRET=change-me-to-a-different-32-plus-character-random-string
# Only tokens with this issuer are accepted
JWT_ISSUER=marketing-portal
# Optional: extra issuers to accept, comma-separated (e.g. another portal sharing this JWT_SECRET).
# The travel management system signs its service tokens as zenatech-internal-portal.
JWT_ACCEPTED_ISSUERS=zenatech-internal-portal
AUTH_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false

# --- Microsoft Entra ID SSO ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8006/api/auth/microsoft/callback
ALLOWED_EMAIL_DOMAINS=
INITIAL_SUPER_ADMIN_EMAILS=admin@example.com

# --- Optional: Gemini AI assistant (disabled when empty) ---
GEMINI_API_KEY=

# --- Optional: Microsoft Graph background sync ---
GRAPH_BACKGROUND_SYNC_ENABLED=false

# --- Service messaging (same setup as the admin portal) ---
# Announce this service online/offline over MQTT on services/<SERVICE_NAME>/<SERVICE_INSTANCE_ID>/status.
# On by default when APP_ENV=production, off otherwise.
MQTT_PRESENCE_ENABLED=false
SERVICE_NAME=marketing
SERVICE_INSTANCE_ID=marketing-01
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_KEEPALIVE_SECONDS=15
# Connect to RabbitMQ and declare the shared exchanges (nothing is published yet).
# On by default when APP_ENV=production, off otherwise. Use RABBITMQ_URL, or the host/port/user/password below.
RABBITMQ_ENABLED=false
RABBITMQ_URL=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Travel management system (we read approved travel costs from it) ---
# Base URL, no trailing slash. Leave empty to turn travel calls off.
TRAVEL_BACKEND_URL=
# Seconds to wait for the travel system before giving up
TRAVEL_TIMEOUT_SECONDS=10
# Pull approved travel costs into event costs on a schedule (needs the travel system's costs endpoint)
TRAVEL_COST_SYNC_ENABLED=false
# Minutes between scheduled syncs (minimum 5)
TRAVEL_COST_SYNC_INTERVAL_MINUTES=360
