{
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
    "files.watcherExclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/dist": true
    },
    "search.exclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/dist": true
    },
    "files.exclude": {
        "**/venv": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true
    },
    "python.analysis.exclude": [
        "**/venv",
        "**/.venv",
        "**/node_modules"
    ]
}
